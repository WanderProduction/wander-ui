{
  "name": "@wander/ui",
  "version": "0.1.0",
  "description": "Shared UI pieces for the Wander apps — an icon picker and a colour picker, with the pure rules behind them.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WanderProduction/wander-ui.git"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/wander-ui.js",
      "default": "./dist/wander-ui.js"
    },
    "./src/*": "./src/*"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "prepare": "vite build",
    "verify": "node scripts/verify-icon-picker.mjs && node scripts/verify-color.mjs && node scripts/verify-tokens.mjs",
    "lint": "eslint .",
    "check": "npm run build && npm run verify && npm run lint",
    "dev": "vite"
  },
  "peerDependencies": {
    "lucide-react": ">=1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.5",
    "vite": "^8.0.12"
  }
}
